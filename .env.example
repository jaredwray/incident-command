# Incident Command configuration
#
# Copy to `.env` and adjust:  cp .env.example .env
# Every variable is optional. Empty values (FOO=) are treated as unset.
# Durations accept ms, s, m, h, hr or d (for example 30s, 15m, 7d) or plain
# milliseconds.
# Full reference: docs/deployment.md

# --- Server -------------------------------------------------------------------
# Port for the server (default 3000). Containers should also bind 0.0.0.0
# (the Docker image already sets both).
# PORT=3000
# HOSTNAME=0.0.0.0

# --- Site ---------------------------------------------------------------------
# Public URL of the status page, used in notification links.
SITE_URL=http://localhost:3000
# Initial site name (default "Status"); editable later in the portal.
# SITE_NAME=Status

# --- Storage ------------------------------------------------------------------
# The adapter is picked from the URL scheme:
#   postgres:// or postgresql://  -> Postgres (tables are created on boot)
#   mongodb:// or mongodb+srv://  -> MongoDB
#   unset or memory://            -> in-memory: dev/demo only, data is lost on
#                                    restart and not shared between instances
# With docker compose, leave this unset to use the bundled Postgres, or use the
# service names (postgres, mongo) instead of localhost.
# DATABASE_URI=postgres://incident:incident@localhost:5432/incident_command
# DATABASE_URI=mongodb://localhost:27017/incident_command

# Force an adapter instead of detecting it from DATABASE_URI: memory | postgres | mongo
# STORE=postgres

# MongoDB database name (default: the database named in DATABASE_URI).
# DATABASE_NAME=incident_command

# Postgres table name prefix (default ic_).
# DATABASE_TABLE_PREFIX=ic_

# Keep a Postgres connection pool: true | false. Defaults to true, and to false
# on Cloudflare Workers (which cannot share connections between requests).
# DATABASE_POOL=true

# Seed demo services and incidents into an empty store on boot (true or 1).
# Handy with the memory store for demos.
# SEED_DEMO=true

# --- Cache --------------------------------------------------------------------
# How long reads stay fresh in the in-process cache (default 30s). While the
# database is offline the last known data keeps being served.
# CACHE_TTL=30s
# Maximum cached entries per instance (default 5000).
# CACHE_MAX_ENTRIES=5000

# --- Portal access ------------------------------------------------------------
# Portal session lifetime (default 7d).
# SESSION_TTL=7d

# First admin: visit /manage/setup. Set a token to require it there.
# Without it, whoever reaches that page first becomes admin.
# SETUP_TOKEN=replace-with-a-long-random-string

# --- Notifications: encrypted credentials -----------------------------------
# Admins set up webhooks, email and text messages in Manage -> Settings ->
# Notifications. Each channel can have more than one provider (active/passive
# or load balanced). The database keeps provider credentials encrypted with
# this key. Keep it in the secret store of your platform. It must have at least
# 32 characters. Make one with:  openssl rand -base64 32
# ENCRYPTION_KEY=replace-with-a-base64-key-of-32-bytes
# To change the key, set the old key here (comma-separated for more than one),
# save each channel once, then remove it.
# ENCRYPTION_KEY_PREVIOUS=

# --- Notifications: providers from environment variables -------------------
# A channel without providers in the portal uses these, so existing
# deployments keep working. A provider added in the portal replaces them.

# Webhooks always have the built-in sender. When set, payloads are signed with
# HMAC-SHA256 in the header  x-incident-command-signature: sha256=<hex>
# WEBHOOK_SECRET=replace-with-a-long-random-string

# The default email sender, also for providers added in the portal.
# EMAIL_FROM=status@example.com
# Force a provider: sendgrid | ses (default: sendgrid when SENDGRID_API_KEY is
# set, otherwise ses when AWS_SES_REGION is set).
# EMAIL_PROVIDER=sendgrid

# SendGrid.
# SENDGRID_API_KEY=SG.xxxxxxxx

# AWS SES. AWS_SES_REGION takes precedence over AWS_REGION; with only
# AWS_REGION set, also set EMAIL_PROVIDER=ses. Leave the keys unset to use the
# platform's IAM role.
# AWS_SES_REGION=us-east-1
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxx

# --- Build --------------------------------------------------------------------
# Set it for `next build`. Next.js salts the server action ids with this key.
# Use the same key for each build, or each deploy changes the ids and open
# portal pages fail on their next form submit until a reload.
# Make one with:  openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-base64-key-of-32-bytes
