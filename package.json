{
	"name": "incident-command",
	"version": "0.1.0",
	"description": "Open source incident command: a skinnable status page, a management portal, and an MCP server so agents can run the whole thing. Deploy anywhere.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"author": "Jared Wray <me@jaredwray.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/jaredwray/incident-command.git"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check --write --error-on-warnings",
		"lint:ci": "biome check --error-on-warnings",
		"typecheck": "tsc --noEmit",
		"test": "pnpm lint && vitest run --coverage",
		"test:ci": "pnpm lint:ci && pnpm typecheck && vitest run --coverage",
		"test:watch": "vitest",
		"cf:build": "opennextjs-cloudflare build",
		"cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"clean": "rm -rf .next .open-next coverage node_modules"
	},
	"dependencies": {
		"@airhornjs/aws": "^7.2.0",
		"@airhornjs/twilio": "^7.2.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"airhorn": "^7.2.0",
		"cacheable": "^2.5.0",
		"mongodb": "^7.7.0",
		"next": "^16.4.4",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@electric-sql/pglite": "^0.5.12",
		"@opennextjs/cloudflare": "^1.20.13",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"@vitest/coverage-v8": "~5.0.5",
		"jsdom": "^30.1.3",
		"mongodb-memory-server": "^11.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vitest": "~5.0.5",
		"wrangler": "^4.156.2"
	}
}
