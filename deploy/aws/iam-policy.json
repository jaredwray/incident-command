{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "SendEmailWithSes",
			"Effect": "Allow",
			"Action": ["ses:SendEmail", "ses:SendRawEmail"],
			"Resource": "*"
		},
		{
			"Sid": "ReadIncidentCommandSecrets",
			"Effect": "Allow",
			"Action": "secretsmanager:GetSecretValue",
			"Resource": "arn:aws:secretsmanager:*:*:secret:incident-command/*"
		}
	]
}
